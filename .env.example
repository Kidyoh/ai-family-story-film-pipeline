# Provider mode: real | mock. Empty means "real if a key is present".
PROVIDER_MODE=

# Gemini: narration (TTS, 10 requests/day free). Keyframes only as a fallback:
# the image model is paid-only. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cloudflare Workers AI: keyframes (FLUX.2, text or photo-referenced) and,
# optionally, video. The 4B model is the default: the 9B one costs about five
# times more per frame and exhausts the daily free allowance quickly.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Video is optional. Without either of these, shots.py animates the keyframes
# with Ken Burns and logs the fallback. Both contracts are in ARCHITECTURE.md.
CF_VIDEO_MODEL=
WAN_ENDPOINT=
WAN_API_KEY=

# Music is optional. Without it, music.py writes the synthesised fallback.
MUSIC_ENDPOINT=

# OpenRouter: hosted video (first-frame image-to-video on the four `wan` shots)
# and music (Lyria clips, when MUSIC_ENDPOINT is empty). Proprietary models.
# Every call is checked against OPENROUTER_BUDGET_USD first; spending is read
# from runs.jsonl, so the cap holds across runs. A call that would cross it is
# refused and the stage falls back. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BUDGET_USD=2.00
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
OPENROUTER_VIDEO_RESOLUTION=720p
OPENROUTER_MUSIC_MODEL=google/lyria-3-clip-preview

# Hugging Face: one token for the open-weight models the film can use through
# Hugging Face Inference Providers (billed to the token's account).
#   video    Wan 2.2 image-to-video, for the four `wan` shots
#   music    Stable Audio, when MUSIC_ENDPOINT is empty
#   ambience Stable Audio, one clip per shot from its `ambience` line
# Create a token with "Make calls to Inference Providers" at
# https://huggingface.co/settings/tokens and accept the Stable Audio terms on
# its model page once. Leave empty to keep the local fallbacks.
HF_TOKEN=
HF_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B
HF_AUDIO_MODEL=stabilityai/stable-audio-3-medium
